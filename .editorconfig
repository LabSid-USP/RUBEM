# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rst]
indent_size = 3

[Makefile]
indent_style = tab

# Binary fixtures and rasters are never touched by editors.
[*.{map,tif,tiff,png,pdf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
