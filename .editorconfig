# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rst]
indent_size = 3

[Makefile]
indent_style = tab

# Binary fixtures and rasters are never touched by editors; PCRaster series
# members and goldens (*.NNN, e.g. etp00000.001) are binary too.
[{*.map,*.tif,*.tiff,*.png,*.pdf,*.[0-9][0-9][0-9]}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
